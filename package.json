{
  "name": "bench-workbench",
  "version": "8.0.0-beta.1",
  "private": true,
  "description": "本机统筹工作台 — 跨会话记忆、多 Agent 协作、规范驱动长期任务",
  "scripts": {
    "start": "node server.js",
    "desktop": "node scripts/run-desktop.js",
    "brief": "node cli.js brief",
    "tasks": "node cli.js tasks",
    "test:agents": "node scripts/run-tests.cjs agents --serial",
    "test": "node scripts/run-tests.cjs unit",
    "test:serial": "node scripts/run-tests.cjs unit --serial",
    "build:assets": "node scripts/build-assets.cjs",
    "prestart": "npm run build:assets",
    "test:ui": "node scripts/run-tests.cjs ui",
    "test:skills": "node scripts/run-tests.cjs skills --serial",
    "test:papers": "node scripts/run-tests.cjs papers --serial"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "docx": "9.10.0",
    "fast-xml-parser": "5.11.2",
    "i18next": "26.4.3",
    "markdown-it": "15.0.2",
    "mermaid": "12.1.0"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.0"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
